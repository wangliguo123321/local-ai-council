#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
PY="$DIR/.venv/bin/python"
if [ ! -x "$PY" ]; then
  PY="python3"
fi
PORT="${PORT:-7860}"
URL="http://127.0.0.1:$PORT"
if command -v open >/dev/null 2>&1; then
  (sleep 1; open "$URL") >/dev/null 2>&1 &
fi
exec "$PY" -m uvicorn web_app:app --host 127.0.0.1 --port "$PORT"
